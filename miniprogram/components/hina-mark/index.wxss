.hina-mark {
  position: relative;
  width: 142rpx;
  height: 142rpx;
  flex: none;
}

.hina-mark.small {
  width: 64rpx;
  height: 64rpx;
}

.face {
  position: absolute;
  inset: 18rpx;
  z-index: 2;
  overflow: hidden;
  border: 2rpx solid rgba(48, 45, 42, 0.14);
  border-radius: 46% 54% 48% 52%;
  background: linear-gradient(145deg, #ffd778, #f1a843);
  box-shadow: inset -12rpx -14rpx 0 rgba(168, 100, 44, 0.11), 0 14rpx 30rpx rgba(111, 71, 31, 0.18);
}

.small .face {
  inset: 7rpx;
  box-shadow: inset -5rpx -6rpx 0 rgba(168, 100, 44, 0.11), 0 5rpx 12rpx rgba(111, 71, 31, 0.16);
}

.eye {
  position: absolute;
  top: 43%;
  width: 10rpx;
  height: 13rpx;
  border-radius: 50%;
  background: #49372b;
}

.small .eye {
  width: 4rpx;
  height: 5rpx;
}

.eye-left { left: 29%; }
.eye-right { right: 29%; }

.smile {
  position: absolute;
  left: 38%;
  top: 56%;
  width: 24%;
  height: 13%;
  border-bottom: 4rpx solid #6d4631;
  border-radius: 0 0 50% 50%;
}

.small .smile { border-bottom-width: 2rpx; }

.orbit {
  position: absolute;
  inset: 6rpx;
  border: 2rpx solid rgba(82, 99, 87, 0.25);
  border-radius: 50%;
  transform: rotate(22deg);
}

.orbit-two {
  inset: 0 14rpx;
  border-color: rgba(185, 104, 111, 0.2);
  transform: rotate(-37deg);
}

.spark {
  position: absolute;
  right: 0;
  top: 0;
  z-index: 3;
  color: #526357;
  font-size: 34rpx;
}

.small .spark { font-size: 15rpx; }
