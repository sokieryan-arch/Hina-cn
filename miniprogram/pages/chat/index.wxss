.chat-page {
  display: flex;
  height: 100vh;
  flex-direction: column;
  overflow: hidden;
}

.chat-header {
  position: relative;
  z-index: 5;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx 18rpx;
  border-bottom: 1rpx solid rgba(108, 94, 77, 0.13);
  background: rgba(248, 243, 234, 0.92);
}

.identity,
.name-row {
  display: flex;
  align-items: center;
}

.identity { gap: 18rpx; }
.name { font-family: Georgia, serif; font-size: 35rpx; font-weight: 600; }

.status-dot {
  width: 11rpx;
  height: 11rpx;
  margin-left: 12rpx;
  border-radius: 50%;
  background: #66a27b;
  box-shadow: 0 0 0 7rpx rgba(102, 162, 123, 0.12);
}

.presence { color: #817870; font-size: 21rpx; }

.quota {
  display: flex;
  min-width: 86rpx;
  flex-direction: column;
  align-items: flex-end;
}

.quota-number { color: #526357; font-family: Georgia, serif; font-size: 31rpx; font-weight: 700; }
.quota-label { color: #958b82; font-size: 18rpx; letter-spacing: 2rpx; }

.conversation {
  min-height: 0;
  flex: 1;
}

.loading-conversation,
.empty-conversation {
  display: flex;
  min-height: 68vh;
  padding: 54rpx 42rpx 40rpx;
  box-sizing: border-box;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.loading-conversation text { margin-top: 28rpx; color: #817870; }
.empty-conversation .display-title { max-width: 620rpx; margin-top: 18rpx; font-size: 52rpx; }
.empty-copy { max-width: 590rpx; margin-top: 24rpx; color: #736b64; font-size: 25rpx; line-height: 1.8; }

.starter-list {
  display: flex;
  width: 100%;
  margin-top: 42rpx;
  flex-direction: column;
  gap: 16rpx;
}

.starter {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 26rpx;
  border: 1rpx solid #e2d7c8;
  border-radius: 26rpx;
  background: rgba(255, 253, 249, 0.86);
  color: #4f4944;
  font-size: 23rpx;
  line-height: 82rpx;
  text-align: left;
}

.message-list { padding: 34rpx 26rpx 0; }

.message-row {
  display: flex;
  margin-bottom: 28rpx;
  align-items: flex-start;
  gap: 14rpx;
}

.user-row { justify-content: flex-end; }
.tip-row { padding-left: 78rpx; }

.message-card {
  max-width: 79%;
  padding: 24rpx 26rpx;
  border-radius: 30rpx;
}

.model-card {
  border: 1rpx solid #e1d7c9;
  border-top-left-radius: 10rpx;
  background: #fffdf9;
  box-shadow: 0 12rpx 32rpx rgba(67, 52, 35, 0.06);
}

.user-card {
  border-bottom-right-radius: 10rpx;
  background: #526357;
  color: #fffdf8;
  box-shadow: 0 12rpx 28rpx rgba(55, 68, 61, 0.16);
}

.tip-card {
  max-width: 90%;
  border: 1rpx dashed #d8c7a9;
  border-radius: 20rpx;
  background: #fff8e9;
  color: #4c4540;
  box-shadow: none;
}

.tip-label {
  margin-bottom: 10rpx;
  color: #9a6d2f;
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
}

.message-text {
  white-space: pre-wrap;
  font-size: 27rpx;
  line-height: 1.72;
}

.voice-button {
  display: inline-flex;
  width: auto;
  min-height: 54rpx;
  margin: 18rpx 0 0;
  padding: 0 20rpx;
  align-items: center;
  gap: 10rpx;
  border-radius: 27rpx;
  background: #f2eadf;
  color: #655a51;
  font-size: 20rpx;
  line-height: 54rpx;
}

.voice-button.playing { background: #e5eee8; color: #405b4b; }

.typing-card {
  display: flex;
  gap: 9rpx;
  padding: 25rpx 28rpx;
  border: 1rpx solid #e1d7c9;
  border-radius: 28rpx 28rpx 28rpx 10rpx;
  background: #fffdf9;
}

.typing-card text {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #84796e;
  animation: blink 1s infinite alternate;
}

.typing-card text:nth-child(2) { animation-delay: .2s; }
.typing-card text:nth-child(3) { animation-delay: .4s; }
@keyframes blink { to { opacity: .25; transform: translateY(-5rpx); } }

.conversation-end { height: 270rpx; }

.composer-shell {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(112rpx + env(safe-area-inset-bottom));
  z-index: 40;
  padding: 12rpx 26rpx 8rpx;
  background: linear-gradient(180deg, rgba(248, 243, 234, 0), rgba(248, 243, 234, .98) 28%);
}

.composer-card {
  display: flex;
  align-items: flex-end;
  gap: 12rpx;
  padding: 12rpx 12rpx 12rpx 24rpx;
  border: 1rpx solid #ded3c4;
  border-radius: 34rpx;
  background: #fffdf9;
  box-shadow: 0 16rpx 44rpx rgba(66, 52, 36, .12);
}

.composer {
  max-height: 160rpx;
  min-height: 60rpx;
  padding: 13rpx 0 6rpx;
  flex: 1;
  color: #36312e;
  font-size: 26rpx;
  line-height: 1.45;
}

.composer-placeholder { color: #aaa198; }

.send-button {
  width: 70rpx;
  min-width: 70rpx;
  height: 70rpx;
  padding: 0;
  border-radius: 50%;
  background: #37443d;
  color: white;
  font-size: 38rpx;
  line-height: 68rpx;
}

.send-button[disabled] { background: #c8c4bd; color: #f7f3ed; }
.ai-note { display: block; margin-top: 8rpx; color: #a19890; font-size: 18rpx; text-align: center; }
