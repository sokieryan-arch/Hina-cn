.document-page { min-height: 100vh; padding: 54rpx 34rpx 90rpx; box-sizing: border-box; background: #f8f3ea; color: #3f3935; }
.eyebrow { display: block; color: #9a6d2f; font-size: 19rpx; font-weight: 800; letter-spacing: 4rpx; }
.document-title { display: block; margin-top: 16rpx; font-family: Georgia, "Songti SC", serif; font-size: 50rpx; font-weight: 600; }
.document-meta { display: block; margin-top: 18rpx; color: #8c827a; font-size: 22rpx; }
.section { display: flex; margin-top: 36rpx; padding: 0 4rpx; flex-direction: column; gap: 13rpx; color: #625a54; font-size: 25rpx; line-height: 1.82; }
.heading { color: #332e2b; font-family: Georgia, "Songti SC", serif; font-size: 31rpx; font-weight: 600; }
.warning { padding: 28rpx; border: 1rpx solid #e4c9c8; border-radius: 26rpx; background: #fff7f6; }
